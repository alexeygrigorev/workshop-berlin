# Copy to deploy/.env and edit. deploy/.env is gitignored.
# Public hostname; with no domain use <server-ip-with-dashes>.sslip.io (e.g. IP 203.0.113.7).
DOMAIN=203-0-113-7.sslip.io
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me
# Production starts empty. Set to true only for a throw-away demo: it seeds demo users that all share the
# password `password123`, and it only runs against an empty database.
WSWE_SEED_DEMO_DATA=false
